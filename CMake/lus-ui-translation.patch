@@ -5,6 +5,24 @@
 #include "ship/window/gui/Gui.h"
 
 namespace Ship {
+namespace {
+GuiWindow::TextTranslator textTranslator = nullptr;
+GuiWindow::TextTranslator labelTranslator = nullptr;
+}
+
+void GuiWindow::SetTextTranslators(TextTranslator text, TextTranslator label) {
+    textTranslator = text;
+    labelTranslator = label;
+}
+
+std::string GuiWindow::TranslateText(const std::string& text) {
+    return textTranslator != nullptr ? textTranslator(text) : text;
+}
+
+std::string GuiWindow::TranslateLabel(const std::string& label) {
+    return labelTranslator != nullptr ? labelTranslator(label) : label;
+}
